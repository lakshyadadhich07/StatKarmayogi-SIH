# Database Configuration
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/statkarmayogi_db

# Application Configuration
APP_NAME=StatKarmayogi
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Configuration (comma-separated list or JSON array of allowed origins)
# For production, include your deployed Vercel frontend URL:
# e.g., CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://your-frontend.vercel.app"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8501","http://127.0.0.1:8501"]

# Document Upload & Processing (Phase 4)
UPLOAD_DIR=storage/documents
MAX_UPLOAD_SIZE_MB=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Mistral AI Embeddings & ChromaDB Vector Store (Phase 4)
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_EMBEDDING_MODEL=mistral-embed
CHROMA_PERSIST_DIRECTORY=storage/chroma
CHROMA_COLLECTION_NAME=statkarmayogi_chunks

# Mistral AI LLM & MCQ Generation (Phase 5)
MISTRAL_LLM_MODEL=mistral-large-latest
MISTRAL_TEMPERATURE=0.2
DEFAULT_MCQ_VOLUME=5
MAX_MCQ_VOLUME=20
